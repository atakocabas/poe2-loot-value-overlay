# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build output. `npm run build` compiles src -> dist and copies renderer assets;
# `npm run package` writes the installer, the portable exe and win-unpacked/ here.
dist/
release/
*.tsbuildinfo

# Runtime user data. These live in app.getPath("userData") normally, but a copy
# pulled into the project to debug a parse or a bad price must never be
# committed: a real settings.json carries the user's own league, Client.txt path
# and contact email, and loot-cache.json is their drop history. Only
# config/settings.default.json — a different filename — belongs in the repo.
settings.json
loot-cache.json
loot-cache.pre-clear.json

# Secrets. Nothing here needs a token today (every GGG endpoint this app calls is
# public and unauthenticated), so this is a guard against that changing quietly.
.env
.env.*
*.pem

# Logs and test output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# Per-machine Claude Code permission state, not project configuration.
.claude/settings.local.json

# Editors
.vscode/
.idea/
*.swp
*~

# Windows / macOS shell droppings, which land in a repo built and browsed on both
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
